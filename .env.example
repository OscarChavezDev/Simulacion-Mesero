# ============================================================
# VARIABLES DE ENTORNO - SISTEMA DEL MESERO
# Copia este archivo a .env.local y completa los valores
# ============================================================

# === SUPABASE (base de datos propia: pedidos, items) ===
# Project Settings > API en tu proyecto de https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === SISTEMA DE RESTAURANTES (de donde consumimos menú y mesas) ===
# Local: http://localhost:8080/api · Producción: https://restaurants-h5ma.onrender.com/api
NEXT_PUBLIC_RESTAURANTS_API_URL=http://localhost:8080/api

# UUID del restaurante piloto ("El Encanto de la Selva"). Se obtiene con
# GET {NEXT_PUBLIC_RESTAURANTS_API_URL}/v1/restaurants?search=Encanto
# o desde el dashboard del dueño del restaurante en el sistema de Restaurants.
NEXT_PUBLIC_RESTAURANT_ID=

# API key para marcar mesas ocupadas/libres, generada por el PROPIO dueño del
# restaurante desde su cuenta: Restaurants → dashboard → API Keys → "Generar
# nueva clave". No es un secreto inventado por nosotros — la genera y puede
# revocar el dueño cuando quiera, desde su propio panel. Nunca lleva el
# prefijo NEXT_PUBLIC_: solo se usa desde el servidor (route handler), nunca
# en el navegador del mesero.
RESTAURANTS_API_KEY=
